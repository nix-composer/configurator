{
  "version": 1,
  "basics": {
    "locale": "en_US.UTF-8",
    "keyboardLayout": "us",
    "timezone": "UTC"
  },
  "desktop": {
    "id": "lxqt"
  },
  "keybinds": {
    "SUPER + F11": {
      "action": "exec:qterminal"
    },
    "SUPER + F10": {
      "action": "openbox:<action name=\"Close\" />"
    },
    "ALT + F2": "unbind",
    "SUPER + F9": {
      "exec": "touch /tmp/kb-added"
    }
  },
  "disk": {
    "device": "/dev/vdb",
    "filesystem": "ext4"
  },
  "users": [
    {
      "name": "kim",
      "admin": true
    }
  ],
  "hostname": "keys"
}
