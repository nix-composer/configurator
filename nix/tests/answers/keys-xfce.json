{
  "version": 1,
  "basics": {
    "locale": "en_US.UTF-8",
    "keyboardLayout": "us",
    "timezone": "UTC"
  },
  "desktop": {
    "id": "xfce"
  },
  "keybinds": {
    "SUPER + F11": {
      "action": "commands/exo-open --launch TerminalEmulator"
    },
    "SUPER + F10": {
      "action": "xfwm4/close_window_key"
    },
    "CTRL + ALT + ESCAPE": "unbind",
    "SUPER + F9": {
      "exec": "touch /tmp/kb-added"
    }
  },
  "disk": {
    "device": "/dev/vdb",
    "filesystem": "ext4"
  },
  "users": [
    {
      "name": "kim",
      "admin": true
    }
  ],
  "hostname": "keys"
}
