{
  "version": 1,
  "basics": {
    "locale": "en_US.UTF-8",
    "keyboardLayout": "us",
    "timezone": "UTC"
  },
  "profile": "office",
  "desktop": {
    "id": "gnome"
  },
  "apps": {
    "packages": [
      "gnome-console"
    ]
  },
  "webapps": [
    "youtube"
  ],
  "keybinds": {
    "SUPER + RETURN": {
      "launch": "gnome-console"
    },
    "SUPER + SHIFT + Y": {
      "webapp": "youtube"
    },
    "ALT + F4": "unbind",
    "SUPER + Q": {
      "action": "org.gnome.desktop.wm.keybindings/close"
    },
    "Super_R": {
      "action": "org.gnome.mutter/overlay-key"
    }
  },
  "disk": {
    "device": "/dev/vdb",
    "filesystem": "btrfs"
  },
  "users": [
    {
      "name": "frank",
      "admin": true
    }
  ],
  "hostname": "gnome"
}
