{
  "$comment": "Profiles: a purpose's opinionated setup. `apps` and `webapps` are preselected in the app and web app stores (the answers carry what's kept; apps in programs.json get their NixOS module); `config` is written as the profile's own section. Special values as in desktops.json, plus {\"$context\": \"firstUser\"}.",
  "profiles": [
    {
      "id": "custom",
      "name": "Everything Custom",
      "description": "Nothing preselected: choose everything yourself",
      "apps": [],
      "webapps": [],
      "config": {}
    },
    {
      "id": "office",
      "name": "Office",
      "description": "Documents, email, a browser and printing",
      "apps": [
        "libreoffice",
        "thunderbird",
        "firefox",
        "evince",
        "xournalpp",
        "simple-scan"
      ],
      "webapps": [
        "microsoft-365",
        "google-docs",
        "google-sheets",
        "google-drive",
        "teams"
      ],
      "config": {
        "services.printing.enable": true,
        "services.avahi.enable": true,
        "services.avahi.nssmdns4": true,
        "hardware.sane.enable": true
      }
    },
    {
      "id": "gaming",
      "name": "Gaming",
      "description": "Steam, launchers for other stores, and performance tools",
      "apps": [
        "steam",
        "heroic",
        "lutris",
        "protonup-qt",
        "mangohud",
        "gamescope",
        "gamemode",
        "discord"
      ],
      "webapps": [
        "twitch",
        "xbox-cloud-gaming"
      ],
      "config": {
        "hardware.graphics.enable": true,
        "hardware.graphics.enable32Bit": true
      }
    },
    {
      "id": "kiosk",
      "name": "Kiosk",
      "description": "One app, fullscreen, logged in automatically",
      "apps": [
        "firefox"
      ],
      "webapps": [],
      "config": {
        "services.cage.enable": true,
        "services.cage.user": {
          "$context": "firstUser"
        },
        "services.cage.program": {
          "$expr": "lib.getExe pkgs.firefox + \" --kiosk https://nixos.org\""
        }
      }
    },
    {
      "id": "server",
      "name": "Server",
      "description": "Remote access over SSH and server tools",
      "apps": [
        "htop",
        "btop",
        "tmux",
        "git",
        "rsync",
        "curl",
        "wget"
      ],
      "webapps": [],
      "config": {
        "services.openssh.enable": true
      }
    },
    {
      "id": "headless",
      "name": "Headless",
      "description": "No desktop, reachable over SSH",
      "apps": [],
      "webapps": [],
      "config": {
        "services.openssh.enable": true
      }
    }
  ]
}
