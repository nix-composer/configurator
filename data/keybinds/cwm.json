{
  "$comment": "cwm's built-in default keybinds: key_binds[] in conf.c of nixpkgs' cwm (nixos-26.05). The action is the cwmrc(5) function name; labels from cwmrc(5). Regenerate with scripts/keybinds/extract-x11-wms.py.",
  "binds": [
    {
      "action": "terminal",
      "label": "Spawn a new terminal",
      "group": "Apps",
      "accels": [
        "<Control><Alt>Return"
      ]
    },
    {
      "action": "lock",
      "label": "Lock the screen",
      "group": "Session",
      "accels": [
        "<Control><Alt>Delete"
      ]
    },
    {
      "action": "menu-exec",
      "label": "Launch exec program menu",
      "group": "Apps",
      "accels": [
        "<Alt>question"
      ]
    },
    {
      "action": "menu-exec-wm",
      "label": "Launch exec WindowManager menu",
      "group": "Apps",
      "accels": [
        "<Control><Alt>w"
      ]
    },
    {
      "action": "menu-ssh",
      "label": "Launch ssh menu",
      "group": "Apps",
      "accels": [
        "<Alt>period"
      ]
    },
    {
      "action": "window-hide",
      "label": "Hide current window",
      "group": "Windows",
      "accels": [
        "<Alt>Return"
      ]
    },
    {
