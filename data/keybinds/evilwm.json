{
  "$comment": "evilwm's built-in default keybinds: control_builtins[] in bind.c of nixpkgs' evilwm (nixos-26.05; QWERTY build), mask1 = Control+Alt, mask2 = Alt, altmask = Shift. The action is the function as `bind KEY=function,flags` takes it. Regenerate with scripts/keybinds/extract-x11-wms.py.",
  "binds": [
    {
      "action": "move,relative+up",
      "label": "Move the window up",
      "group": "Windows",
      "accels": [
        "<Control><Alt>k"
      ]
    },
    {
      "action": "move,relative+down",
      "label": "Move the window down",
      "group": "Windows",
      "accels": [
        "<Control><Alt>j"
      ]
    },
    {
      "action": "move,relative+left",
      "label": "Move the window left",
      "group": "Windows",
      "accels": [
        "<Control><Alt>h"
      ]
    },
    {
      "action": "move,relative+right",
      "label": "Move the window right",
      "group": "Windows",
      "accels": [
        "<Control><Alt>l"
      ]
    },
    {
      "action": "move,top+left",
