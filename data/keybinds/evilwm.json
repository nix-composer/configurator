      ]
    },
    {
      "action": "resize,relative+down",
      "label": "Grow the window vertically",
      "group": "Windows",
      "accels": [
        "<Control><Alt><Shift>j"
      ]
    },
    {
      "action": "resize,relative+left",
      "label": "Shrink the window horizontally",
