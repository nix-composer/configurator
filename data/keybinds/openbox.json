{
  "$comment": "Openbox's default keybinds: the <keyboard> section of etc/xdg/openbox/rc.xml in nixpkgs' openbox (nixos-26.05). The action is the keybind's <action> elements as rc.xml writes them. Regenerate with scripts/keybinds/extract-x11-wms.py.",
  "binds": [
    {
      "action": "<action name=\"GoToDesktop\"><to>left</to><wrap>no</wrap></action>",
      "label": "Go to desktop left",
      "group": "Workspaces",
      "accels": [
        "<Control><Alt>Left"
      ]
    },
    {
      "action": "<action name=\"GoToDesktop\"><to>right</to><wrap>no</wrap></action>",
      "label": "Go to desktop right",
      "group": "Workspaces",
      "accels": [
        "<Control><Alt>Right"
      ]
    },
    {
      "action": "<action name=\"GoToDesktop\"><to>up</to><wrap>no</wrap></action>",
      "label": "Go to desktop up",
      "group": "Workspaces",
      "accels": [
        "<Control><Alt>Up"
      ]
    },
    {
      "action": "<action name=\"GoToDesktop\"><to>down</to><wrap>no</wrap></action>",
      "label": "Go to desktop down",
      "group": "Workspaces",
      "accels": [
        "<Control><Alt>Down"
      ]
    },
    {
      "action": "<action name=\"SendToDesktop\"><to>left</to><wrap>no</wrap></action>",
      "label": "Send window to desktop left",
      "group": "Workspaces",
      "accels": [
        "<Alt><Shift>Left"
      ]
    },
    {
      "action": "<action name=\"SendToDesktop\"><to>right</to><wrap>no</wrap></action>",
      "label": "Send window to desktop right",
      "group": "Workspaces",
      "accels": [
        "<Alt><Shift>Right"
      ]
    },
    {
      "action": "<action name=\"SendToDesktop\"><to>up</to><wrap>no</wrap></action>",
      "label": "Send window to desktop up",
      "group": "Workspaces",
      "accels": [
        "<Alt><Shift>Up"
      ]
    },
    {
      "action": "<action name=\"SendToDesktop\"><to>down</to><wrap>no</wrap></action>",
      "label": "Send window to desktop down",
      "group": "Workspaces",
      "accels": [
        "<Alt><Shift>Down"
      ]
    },
    {
      "action": "<action name=\"GoToDesktop\"><to>1</to></action>",
      "label": "Go to desktop 1",
      "group": "Workspaces",
      "accels": [
        "<Super>F1"
      ]
    },
    {
      "action": "<action name=\"GoToDesktop\"><to>2</to></action>",
      "label": "Go to desktop 2",
      "group": "Workspaces",
      "accels": [
        "<Super>F2"
      ]
    },
    {
      "action": "<action name=\"GoToDesktop\"><to>3</to></action>",
      "label": "Go to desktop 3",
      "group": "Workspaces",
      "accels": [
        "<Super>F3"
      ]
    },
    {
      "action": "<action name=\"GoToDesktop\"><to>4</to></action>",
      "label": "Go to desktop 4",
      "group": "Workspaces",
      "accels": [
        "<Super>F4"
      ]
    },
    {
      "action": "<action name=\"ToggleShowDesktop\" />",
      "label": "Show the desktop",
      "group": "Workspaces",
      "accels": [
        "<Super>d"
      ]
    },
    {
      "action": "<action name=\"Close\" />",
      "label": "Close the window",
      "group": "Windows",
      "accels": [
        "<Alt>F4"
      ]
    },
    {
      "action": "<action name=\"Lower\" /><action name=\"FocusToBottom\" /><action name=\"Unfocus\" />",
      "label": "Lower the window and unfocus it",
      "group": "Focus",
      "accels": [
        "<Alt>Escape"
      ]
    },
    {
      "action": "<action name=\"ShowMenu\"><menu>client-menu</menu></action>",
      "label": "Window menu",
      "group": "Menus",
      "accels": [
        "<Alt>space"
      ]
    },
    {
      "action": "<action name=\"NextWindow\"><finalactions><action name=\"Focus\" /><action name=\"Raise\" /><action name=\"Unshade\" /></finalactions></action>",
      "label": "Next window",
      "group": "Focus",
      "accels": [
        "<Alt>Tab"
      ]
    },
    {
      "action": "<action name=\"PreviousWindow\"><finalactions><action name=\"Focus\" /><action name=\"Raise\" /><action name=\"Unshade\" /></finalactions></action>",
      "label": "Previous window",
      "group": "Focus",
      "accels": [
        "<Alt><Shift>Tab"
      ]
    },
    {
      "action": "<action name=\"NextWindow\"><panels>yes</panels><desktop>yes</desktop><finalactions><action name=\"Focus\" /><action name=\"Raise\" /><action name=\"Unshade\" /></finalactions></action>",
      "label": "Next window (all desktops, panels too)",
      "group": "Focus",
      "accels": [
        "<Control><Alt>Tab"
      ]
    },
    {
      "action": "<action name=\"DirectionalCycleWindows\"><direction>right</direction></action>",
      "label": "Focus the window to the right",
      "group": "Focus",
      "accels": [
        "<Super><Shift>Right"
      ]
    },
    {
      "action": "<action name=\"DirectionalCycleWindows\"><direction>left</direction></action>",
      "label": "Focus the window to the left",
      "group": "Focus",
      "accels": [
        "<Super><Shift>Left"
      ]
    },
    {
      "action": "<action name=\"DirectionalCycleWindows\"><direction>up</direction></action>",
      "label": "Focus the window above",
      "group": "Focus",
      "accels": [
        "<Super><Shift>Up"
      ]
    },
    {
      "action": "<action name=\"DirectionalCycleWindows\"><direction>down</direction></action>",
      "label": "Focus the window below",
      "group": "Focus",
      "accels": [
        "<Super><Shift>Down"
      ]
    },
    {
      "action": "<action name=\"Execute\"><startupnotify><enabled>true</enabled><name>Konqueror</name></startupnotify><command>kfmclient openProfile filemanagement</command></action>",
      "label": "Run kfmclient openProfile filemanagement",
      "group": "Apps",
      "accels": [
        "<Super>e"
      ]
    }
  ]
}
