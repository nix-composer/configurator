{
  "$comment": "dwm's compiled-in default keys: keys[] in config.def.h of nixpkgs' dwm (nixos-26.05), MODKEY = Mod1Mask (Alt), TAGKEYS spelled out. The action is `<function> <argument>` as keys[] writes them. Regenerate with scripts/keybinds/extract-x11-wms.py.",
  "binds": [
    {
      "action": "spawn {.v = dmenucmd }",
      "label": "Run a program (dmenu)",
      "group": "Apps",
      "accels": [
        "<Alt>p"
      ]
    },
    {
      "action": "spawn {.v = termcmd }",
      "label": "Open a terminal (st)",
      "group": "Apps",
      "accels": [
        "<Alt><Shift>Return"
      ]
    },
    {
      "action": "togglebar {0}",
      "label": "Toggle the bar",
      "group": "Windows",
      "accels": [
        "<Alt>b"
      ]
    },
    {
      "action": "focusstack {.i = +1 }",
      "label": "Focus the next window",
      "group": "Focus",
      "accels": [
        "<Alt>j"
      ]
    },
    {
      "action": "focusstack {.i = -1 }",
      "label": "Focus the previous window",
      "group": "Focus",
      "accels": [
        "<Alt>k"
      ]
    },
    {
      "action": "incnmaster {.i = +1 }",
      "label": "More windows in the master area",
      "group": "Workspaces",
      "accels": [
        "<Alt>i"
      ]
    },
    {
      "action": "incnmaster {.i = -1 }",
      "label": "Fewer windows in the master area",
      "group": "Workspaces",
      "accels": [
        "<Alt>d"
      ]
    },
    {
      "action": "setmfact {.f = -0.05}",
      "label": "Shrink the master area",
      "group": "Workspaces",
      "accels": [
        "<Alt>h"
      ]
    },
    {
      "action": "setmfact {.f = +0.05}",
      "label": "Grow the master area",
      "group": "Workspaces",
      "accels": [
        "<Alt>l"
      ]
    },
    {
      "action": "zoom {0}",
      "label": "Move the window to/from the master area",
      "group": "Workspaces",
      "accels": [
