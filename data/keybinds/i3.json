{
  "$comment": "i3's default keybinds from etc/i3/config of nixpkgs nixos-26.05 `i3` (pqwrk681wcrhhhkdkh5cz006gkvzlv5s-i3-4.24): the fallback config i3 loads when no user config exists (Mod1 = Alt). Variables resolved; resize mode's binds left out (scripts/keybinds/extract-compositors.py).",
  "binds": [
    {
      "action": "exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && killall -SIGUSR1 i3status",
      "label": "Volume up",
      "group": "Media",
      "accels": [
        "XF86AudioRaiseVolume"
      ]
    },
    {
      "action": "exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && killall -SIGUSR1 i3status",
      "label": "Volume down",
      "group": "Media",
      "accels": [
        "XF86AudioLowerVolume"
      ]
    },
    {
      "action": "exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && killall -SIGUSR1 i3status",
      "label": "Mute audio",
      "group": "Media",
      "accels": [
        "XF86AudioMute"
      ]
    },
    {
      "action": "exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && killall -SIGUSR1 i3status",
      "label": "Mute the microphone",
      "group": "Media",
      "accels": [
        "XF86AudioMicMute"
      ]
    },
    {
      "action": "exec i3-sensible-terminal",
      "label": "Open a terminal (i3-sensible-terminal)",
      "group": "Apps",
      "accels": [
        "<Alt>Return"
      ]
    },
    {
      "action": "kill",
      "label": "Close the window",
      "group": "Windows",
      "accels": [
        "<Alt><Shift>q"
      ]
    },
    {
      "action": "exec --no-startup-id dmenu_run",
