{
  "$comment": "Hyprland's default keybinds from share/hypr/hyprland.lua of nixpkgs nixos-26.05 `hyprland` (13hnfn0v051rvi2j88gas9b0biq38zm9-hyprland-0.55.4), the example Lua config Hyprland also writes to ~/.config/hypr/hyprland.lua when no config exists. The action is the hl.bind dispatcher as a Lua expression, variables resolved; the XF86 binds pass { locked = true } (volume and brightness also repeating = true). Mouse and scroll binds left out (scripts/keybinds/extract-compositors.py).",
  "binds": [
    {
      "action": "hl.dsp.exec_cmd(\"kitty\")",
      "label": "Open a terminal (kitty)",
      "group": "Apps",
      "accels": [
        "<Super>q"
      ]
    },
    {
      "action": "hl.dsp.window.close()",
      "label": "Close the window",
      "group": "Windows",
      "accels": [
        "<Super>c"
      ]
    },
    {
      "action": "hl.dsp.exec_cmd(\"command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'\")",
      "label": "Exit Hyprland",
      "group": "Session",
      "accels": [
        "<Super>m"
      ]
    },
    {
      "action": "hl.dsp.exec_cmd(\"dolphin\")",
