      "label": "Lower the window and unfocus it",
      "group": "Windows (Openbox)",
      "accels": [
        "<Alt>Escape"
      ]
    },
    {
      "action": "openbox:<action name=\"ShowMenu\"><menu>client-menu</menu></action>",
      "label": "Window menu",
      "group": "Windows (Openbox)",
      "accels": [
        "<Alt>space"
      ]
    },
    {
      "action": "openbox:<action name=\"NextWindow\"><finalactions><action name=\"Focus\" /><action name=\"Raise\" /><action name=\"Unshade\" /></finalactions></action>",
      "label": "Next window",
      "group": "Windows (Openbox)",
      "accels": [
        "<Alt>Tab"
      ]
    },
    {
      "action": "openbox:<action name=\"PreviousWindow\"><finalactions><action name=\"Focus\" /><action name=\"Raise\" /><action name=\"Unshade\" /></finalactions></action>",
      "label": "Previous window",
      "group": "Windows (Openbox)",
      "accels": [
        "<Alt><Shift>Tab"
      ]
    },
