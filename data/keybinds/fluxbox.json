      "group": "Windows",
      "accels": [
        "<Super>4"
      ]
    },
    {
      "action": "Tab 5",
      "label": "Go to tab 5",
      "group": "Windows",
      "accels": [
        "<Super>5"
      ]
    },
    {
      "action": "Tab 6",
      "label": "Go to tab 6",
      "group": "Windows",
      "accels": [
        "<Super>6"
      ]
    },
    {
      "action": "Tab 7",
      "label": "Go to tab 7",
      "group": "Windows",
      "accels": [
        "<Super>7"
      ]
    },
    {
      "action": "Tab 8",
      "label": "Go to tab 8",
      "group": "Windows",
      "accels": [
