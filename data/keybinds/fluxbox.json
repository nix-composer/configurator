      "action": "Tab 9",
      "label": "Go to tab 9",
      "group": "Windows",
      "accels": [
        "<Super>9"
      ]
    },
    {
      "action": "Exec xterm",
      "label": "Open a terminal (xterm)",
      "group": "Apps",
      "accels": [
        "<Alt>F1"
      ]
    },
    {
      "action": "Exec fbrun",
      "label": "Run a program (fbrun)",
      "group": "Apps",
      "accels": [
        "<Alt>F2"
      ]
    },
    {
      "action": "Exec amixer sset Master,0 1+",
      "label": "Volume up (keycode 176)",
      "group": "Media",
      "accels": [
        "XF86AudioRaiseVolume"
      ]
    },
    {
      "action": "Exec amixer sset Master,0 1-",
      "label": "Volume down (keycode 174)",
      "group": "Media",
      "accels": [
        "XF86AudioLowerVolume"
      ]
    },
    {
      "action": "Exec amixer sset Master,0 toggle",
      "label": "Mute (keycode 160)",
      "group": "Media",
      "accels": [
        "XF86AudioMute"
      ]
    },
    {
      "action": "Close",
      "label": "Close the window",
      "group": "Windows",
      "accels": [
        "<Alt>F4"
      ]
    },
    {
      "action": "Kill",
      "label": "Kill the window",
      "group": "Windows",
      "accels": [
        "<Alt>F5"
      ]
    },
    {
      "action": "Minimize",
