{
  "$comment": "Fluxbox's default keybinds: share/fluxbox/keys in nixpkgs' fluxbox (nixos-26.05), copied to ~/.fluxbox/keys on first start. The action is the command after the colon; the volume keys are keycodes 176/174/160 there, given here as their keysyms. Regenerate with scripts/keybinds/extract-x11-wms.py.",
  "binds": [
    {
      "action": "NextWindow {groups} (workspace=[current])",
      "label": "Next window on this workspace",
      "group": "Focus",
      "accels": [
        "<Alt>Tab"
      ]
    },
    {
      "action": "PrevWindow {groups} (workspace=[current])",
      "label": "Previous window on this workspace",
      "group": "Focus",
      "accels": [
        "<Alt><Shift>Tab"
      ]
    },
    {
      "action": "NextTab",
      "label": "Next tab in the window",
      "group": "Focus",
      "accels": [
        "<Super>Tab"
      ]
    },
    {
      "action": "PrevTab",
      "label": "Previous tab in the window",
      "group": "Focus",
      "accels": [
        "<Super><Shift>Tab"
      ]
    },
    {
      "action": "Tab 1",
      "label": "Go to tab 1",
      "group": "Windows",
      "accels": [
        "<Super>1"
      ]
    },
    {
      "action": "Tab 2",
      "label": "Go to tab 2",
      "group": "Windows",
      "accels": [
        "<Super>2"
      ]
    },
    {
      "action": "Tab 3",
