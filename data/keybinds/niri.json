{
  "$comment": "niri's default keybinds from resources/default-config.kdl of nixpkgs nixos-26.05 `niri` (bazsf2g3j9imcrqrw18p3zn9911s7lfm-source), the config niri writes to ~/.config/niri/config.kdl when none exists. Mod is Super (on a TTY; Alt when nested). The action is the bind's KDL action node; bind properties (repeat=false, allow-when-locked=true, hotkey-overlay-title=...) are not part of it. Wheel and touchpad binds left out (scripts/keybinds/extract-compositors.py).",
  "binds": [
    {
      "action": "show-hotkey-overlay",
      "label": "Show the important hotkeys",
      "group": "System",
      "accels": [
        "<Super><Shift>slash"
      ]
    },
    {
      "action": "spawn \"alacritty\"",
      "label": "Open a terminal (alacritty)",
      "group": "Apps",
      "accels": [
        "<Super>t"
      ]
    },
    {
      "action": "spawn \"fuzzel\"",
      "label": "Open the app launcher (fuzzel)",
      "group": "Apps",
      "accels": [
        "<Super>d"
      ]
    },
    {
      "action": "spawn \"swaylock\"",
      "label": "Lock the screen (swaylock)",
      "group": "System",
      "accels": [
        "<Super><Alt>l"
      ]
    },
    {
      "action": "spawn-sh \"pkill orca || exec orca\"",
      "label": "Toggle the Orca screen reader",
      "group": "System",
      "accels": [
        "<Super><Alt>s"
      ]
    },
    {
      "action": "spawn-sh \"wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0\"",
      "label": "Volume up",
      "group": "Media",
      "accels": [
        "XF86AudioRaiseVolume"
      ]
    },
    {
      "action": "spawn-sh \"wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-\"",
      "label": "Volume down",
      "group": "Media",
      "accels": [
        "XF86AudioLowerVolume"
      ]
    },
    {
      "action": "spawn-sh \"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle\"",
      "label": "Mute audio",
      "group": "Media",
      "accels": [
        "XF86AudioMute"
      ]
    },
    {
      "action": "spawn-sh \"wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle\"",
      "label": "Mute the microphone",
      "group": "Media",
      "accels": [
        "XF86AudioMicMute"
      ]
    },
    {
      "action": "spawn-sh \"playerctl play-pause\"",
      "label": "Play or pause",
      "group": "Media",
      "accels": [
        "XF86AudioPlay"
      ]
    },
    {
      "action": "spawn-sh \"playerctl stop\"",
      "label": "Stop playback",
      "group": "Media",
      "accels": [
        "XF86AudioStop"
      ]
    },
    {
      "action": "spawn-sh \"playerctl previous\"",
      "label": "Previous track",
      "group": "Media",
      "accels": [
        "XF86AudioPrev"
      ]
    },
    {
      "action": "spawn-sh \"playerctl next\"",
      "label": "Next track",
      "group": "Media",
      "accels": [
        "XF86AudioNext"
      ]
    },
    {
      "action": "spawn \"brightnessctl\" \"--class=backlight\" \"set\" \"+10%\"",
      "label": "Brightness up",
      "group": "Media",
      "accels": [
        "XF86MonBrightnessUp"
      ]
    },
    {
      "action": "spawn \"brightnessctl\" \"--class=backlight\" \"set\" \"10%-\"",
      "label": "Brightness down",
      "group": "Media",
      "accels": [
        "XF86MonBrightnessDown"
      ]
